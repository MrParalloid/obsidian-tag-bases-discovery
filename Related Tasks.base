filters:
  and:
    - or:
        - todo != NULL
    - or:
        - file.links.contains(this.file)
        - file.fullname.containsAny(this.file.name)
        - and:
            - "!due.isEmpty()"
            - due == date(this.file.name)
        - this.aliases != null && list(this.aliases).filter(file.name.contains(value)).length > 0
        - project != null && project == this.project
    - file.folder != "Files"
    - file.basename != this.file.name
properties:
  file.name:
    displayName: task description
views:
  - type: table
    name: Related Tasks in Note
    filters:
      and:
        - file.basename != this.file.name
    order:
      - todo
      - file.name
      - due
    sort:
      - property: file.name
        direction: ASC
      - property: todo
        direction: ASC
      - property: due
        direction: ASC
    columnSize:
      note.todo: 80
      file.name: 241
      note.due: 120
  - type: table
    name: All Related Tasks
    order:
      - todo
      - file.name
      - due
    sort:
      - property: due
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.todo: 80
      file.name: 254
      note.due: 110
  - type: table
    name: Active Related Tasks
    filters:
      and:
        - todo != true
    order:
      - todo
      - file.name
      - due
    sort:
      - property: due
        direction: DESC
    columnSize:
      file.name: 238
      note.due: 144
